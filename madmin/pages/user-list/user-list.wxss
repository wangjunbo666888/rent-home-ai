.page-list .search-bar {
  background: #fff;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.page-list .search-row-inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.page-list .search-row-inline .search-label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333;
  width: 100rpx;
}

.page-list .search-row-inline .search-input {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
  min-height: 72rpx;
}

.page-list .search-row-inline .btn-sm {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}

.page-list .summary {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.page-list .loading-wrap {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.page-list .table-wrap {
  width: 100%;
  background: #fff;
  border-radius: 12rpx;
}

.page-list .table-container {
  display: flex;
  width: 100%;
}

.page-list .table-fixed {
  width: 220rpx;
  flex-shrink: 0;
  background: #fff;
  border-right: 1rpx solid #eee;
}

.page-list .table-fixed-head,
.page-list .table-fixed-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  min-height: 72rpx;
  box-sizing: border-box;
}

.page-list .table-fixed-head {
  background: #f8f8f8;
  font-weight: bold;
  color: #333;
}

.page-list .table-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.page-list .user-table {
  min-width: 800rpx;
  display: inline-block;
}

.page-list .table-scroll-head,
.page-list .table-scroll-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  min-height: 72rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.page-list .table-scroll-head {
  background: #f8f8f8;
  font-weight: bold;
  color: #333;
}

.page-list .table-scroll-row {
  font-size: 26rpx;
  color: #666;
}

.page-list .user-table .col {
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.page-list .user-table .col-phone {
  width: 220rpx;
}

.page-list .user-table .col-date {
  width: 260rpx;
  color: #666;
}

.page-list .user-table .col-actions {
  width: 280rpx;
  flex-shrink: 0;
}

.page-list .user-table .col-actions .link-btn {
  display: inline-block;
  margin-right: 16rpx;
  color: #1989fa;
  white-space: nowrap;
}

.page-list .pagination {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 32rpx;
  gap: 16rpx;
}

.page-list .btn-page {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.page-list .page-info {
  font-size: 26rpx;
  color: #666;
}
