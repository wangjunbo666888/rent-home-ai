.form-value {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 0;
}

.form-value.form-hint {
  color: #999;
  font-size: 26rpx;
}

.form-picker {
  padding: 24rpx 20rpx;
  min-height: 88rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.error-msg {
  color: #ee0a24;
  font-size: 26rpx;
  margin-top: 16rpx;
}
